{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "analyzer": "secrets",
  "title": "Hardcoded Secrets and Weak Cryptography Static Analysis Rules",
  "rules": [
    {
      "rule_id": "SEC001",
      "name": "Hardcoded credential or secret in source",
      "category": "A02:2021 - Cryptographic Failures",
      "cwe_id": "CWE-798",
      "severity": "CRITICAL",
      "description": "A variable whose name marks it as sensitive (API_KEY, SECRET_KEY, PASSWORD, AWS_SECRET, JWT_SECRET, PRIVATE_KEY and similar) is assigned a non-empty string literal. The value is committed to version control and readable by anyone with repository access, and it cannot be rotated without a code change.",
      "remediation_example": "SECRET_KEY = os.environ['SECRET_KEY']",
      "patterns": {
        "name_tokens": [
          "api_key",
          "apikey",
          "secret",
          "secret_key",
          "password",
          "passwd",
          "pwd",
          "token",
          "access_key",
          "private_key",
          "aws_secret",
          "jwt_secret",
          "client_secret",
          "auth_key"
        ],
        "placeholder_values": [
          "",
          "changeme",
          "change_me",
          "change-me",
          "example",
          "placeholder",
          "your_secret_here",
          "your-key-here",
          "xxx",
          "todo",
          "none",
          "null",
          "redacted",
          "dummy",
          "test",
          "fake",
          "secret",
          "password"
        ],
        "min_length": 4
      },
      "tags": [
        "secrets",
        "credentials",
        "configuration"
      ],
      "references": [
        "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/",
        "https://cwe.mitre.org/data/definitions/798.html"
      ],
      "enabled": true,
      "cve": "CVE-2018-1000656",
      "cve_date": "2018-08-20"
    },
    {
      "rule_id": "SEC002",
      "name": "Weak cryptographic hash function",
      "category": "A02:2021 - Cryptographic Failures",
      "cwe_id": "CWE-327",
      "severity": "HIGH",
      "description": "hashlib.md5() or hashlib.sha1() is used to derive a digest. Both algorithms have practical collision attacks, so they must not be used for signatures, integrity checks or password storage. Pass usedforsecurity=False only when the digest is genuinely non-security (for example a cache key).",
      "remediation_example": "hashlib.sha256(data).hexdigest()  # or hashlib.scrypt / bcrypt for passwords",
      "patterns": {
        "sinks": [
          "md5",
          "sha1",
          "md4",
          "sha"
        ],
        "sink_modules": [
          "hashlib",
          "crypt",
          "_md5",
          "_sha1"
        ],
        "safe_keywords": [
          "usedforsecurity"
        ],
        "password_sinks": [
          "pbkdf2_hmac",
          "scrypt",
          "bcrypt",
          "argon2"
        ]
      },
      "tags": [
        "crypto",
        "hashing",
        "weak-algorithm"
      ],
      "references": [
        "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/",
        "https://cwe.mitre.org/data/definitions/327.html"
      ],
      "enabled": true,
      "cve": "CVE-2021-3177",
      "cve_date": "2021-01-19"
    },
    {
      "rule_id": "SEC003",
      "name": "Insecure random source for security value",
      "category": "A02:2021 - Cryptographic Failures",
      "cwe_id": "CWE-338",
      "severity": "MEDIUM",
      "description": "random.random(), random.randint(), random.choice(), random.choices() or random.getrandbits() supplies a value that is then used as, or assigned to, a token, password, session id, nonce or reset code. The random module is a Mersenne Twister PRNG and is predictable from a modest number of outputs; use the secrets module instead.",
      "remediation_example": "token = secrets.token_urlsafe(32)",
      "patterns": {
        "sinks": [
          "random",
          "randint",
          "randrange",
          "choice",
          "choices",
          "getrandbits",
          "sample",
          "shuffle",
          "uniform"
        ],
        "sink_modules": [
          "random"
        ],
        "security_tokens": [
          "token",
          "password",
          "passwd",
          "secret",
          "session",
          "sid",
          "nonce",
          "otp",
          "salt",
          "csrf",
          "reset",
          "verification",
          "api_key",
          "auth",
          "captcha"
        ]
      },
      "tags": [
        "crypto",
        "randomness",
        "tokens"
      ],
      "references": [
        "https://owasp.org/Top10/A02_2021-Cryptographic_Failures/",
        "https://cwe.mitre.org/data/definitions/338.html"
      ],
      "enabled": true,
      "cve": "CVE-2020-10735",
      "cve_date": "2022-09-09"
    }
  ]
}
